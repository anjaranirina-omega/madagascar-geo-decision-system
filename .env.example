# Global
NODE_ENV=development
APP_NAME=geodecisionnel-madagascar

# PostgreSQL/PostGIS
POSTGRES_HOST=postgres-postgis
POSTGRES_PORT=5432
POSTGRES_DB=geodecisionnel
POSTGRES_USER=geodecisionnel
POSTGRES_PASSWORD=geodecisionnel
DATABASE_URL=postgresql://geodecisionnel:geodecisionnel@postgres-postgis:5432/geodecisionnel

# Backend
BACKEND_PORT=3001
JWT_SECRET=change-me-in-production
AHP_ENGINE_URL=http://ahp-engine:8000

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# External APIs
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPENWEATHER_API_KEY=replace-me
COPERNICUS_API_KEY=replace-me
NASA_EARTHDATA_TOKEN=replace-me

# Superset
SUPERSET_SECRET_KEY=change-me

# Admin contact
ADMIN_CONTACT_EMAIL=admin@riskclim.mg
