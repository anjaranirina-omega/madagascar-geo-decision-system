# ============================================================
# RISKCLIM-MG / Madagascar Geo Decision System
# Exemple de configuration environnement
# Copier ce fichier vers .env puis renseigner les valeurs.
#
# Sécurité : les secrets critiques sont volontairement vides.
# Docker Compose refusera de démarrer certains services si ces
# variables ne sont pas explicitement définies dans .env.
#
# Générer un secret long, par exemple :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Générer une clé API ETL, par exemple :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================


# ============================================================
# Global
# ============================================================

NODE_ENV=development
APP_NAME=madagascar-geo-decision-system


# ============================================================
# PostgreSQL / PostGIS
# ============================================================

POSTGRES_HOST=postgres-postgis
POSTGRES_PORT=5432
POSTGRES_DB=geodecisionnel
POSTGRES_USER=geodecisionnel
# Secret critique : obligatoire pour Docker Compose et la production.
POSTGRES_PASSWORD=

# URL de connexion utilisée par le backend et les scripts ETL.
# Renseigner une URL complète contenant un mot de passe fort.
# Exemple Docker : postgresql://geodecisionnel:<POSTGRES_PASSWORD>@postgres-postgis:5432/geodecisionnel
# Exemple local :  postgresql://geodecisionnel:<POSTGRES_PASSWORD>@localhost:5433/geodecisionnel
DATABASE_URL=


# ============================================================
# Backend NestJS
# ============================================================

BACKEND_PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001

# Secrets critiques : ne jamais conserver de placeholder en production.
JWT_SECRET=
ETL_API_KEY=

AHP_ENGINE_URL=http://localhost:8000


# ============================================================
# Frontend React / Vite
# ============================================================

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001
VITE_ADMIN_CONTACT_EMAIL=admin@riskclim.mg
VITE_ADMIN_CONTACT_PHONE=+261 XX XX XXX XX


# ============================================================
# SMTP / Emails transactionnels
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RISKCLIM-MG <no-reply@example.invalid>"

# Email administrateur recevant les demandes de compte
ADMIN_CONTACT_EMAIL=admin@riskclim.mg


# ============================================================
# OpenTopography / Copernicus DEM GLO-30
# ============================================================

OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DEM_TYPE=COP30
DEM_TILE_SIZE_DEGREES=1.0


# ============================================================
# Sources météo / climat
# ============================================================

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_PARAMETERS=T2M,RH2M,WS2M,PRECTOTCORR
NASA_POWER_DAYS=30
NASA_POWER_AUTO_ENABLED=false
NASA_POWER_CRON=0 30 2 * * *
# Optional fixed period for manual backfill only:
# NASA_POWER_START=20260701
# NASA_POWER_END=20260730

OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_DAILY_QUOTA=950
COPERNICUS_API_KEY=
NASA_EARTHDATA_TOKEN=


# ============================================================
# MinIO / Object Storage compatible S3
# ============================================================

# Identifiants du serveur MinIO. Obligatoires si le service MinIO
# fourni par Docker Compose est utilisé.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Configuration client S3 pour le backend NestJS.
# Hors Docker : http://localhost:9000
# Docker Compose : http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Pour MinIO local, S3_ACCESS_KEY/S3_SECRET_KEY peuvent correspondre
# à MINIO_ROOT_USER/MINIO_ROOT_PASSWORD. En production, préférer si
# possible des identifiants applicatifs dédiés au lieu du compte root.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Noms des buckets applicatifs, auto-créés au démarrage du backend.
S3_BUCKET_AVATARS=geodecisionnel-avatars
S3_BUCKET_REPORTS=geodecisionnel-reports

# Mode d'adressage et sécurité.
# S3_FORCE_PATH_STYLE=true est indispensable pour MinIO.
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

# URL publique S3 pour l'accès navigateur aux assets publics.
S3_PUBLIC_URL=http://localhost:9000


# ============================================================
# Superset / BI
# ============================================================

SUPERSET_SECRET_KEY=


# ============================================================
# CHIRPS rainfall
# ============================================================

# Mois utilisés pour le cumul pluviométrique saisonnier.
CHIRPS_MONTHS=2023-12,2024-01,2024-02,2024-03,2024-04


# ============================================================
# WorldPop population
# ============================================================

WORLDPOP_YEAR=2020
WORLDPOP_COUNTRY=MDG


# ============================================================
# Pipeline automatique de risque côté backend
# ============================================================

RISK_PIPELINE_AUTO_ENABLED=false
# Toutes les 6 heures : seconde minute heure jour mois jourSemaine
RISK_PIPELINE_CRON=0 0 */6 * * *
ETL_PIPELINE_GENERATE_ALERTS=false


# ============================================================
# Alertes validées
# ============================================================

VALIDATED_ALERTS_AFTER_PIPELINE=true
VALIDATED_ALERT_ZONE_TYPE=region
VALIDATED_ALERT_RISK_MEAN_THRESHOLD=60
VALIDATED_ALERT_RISK_MAX_THRESHOLD=70
VALIDATED_ALERT_ZONE_LIMIT=10

# Legacy / weather-risk alerts
AUTO_ALERTS_ENABLED=false
AUTO_ALERT_RISK_THRESHOLD=60
AUTO_ALERT_RAINFALL_THRESHOLD=1
AUTO_ALERT_WIND_THRESHOLD=40
AUTO_ALERT_ZONE_LIMIT=10


# ============================================================
# Realtime weather ingestion
# ============================================================

REALTIME_WEATHER_ENABLED=false
REALTIME_WEATHER_CRON=0 */30 * * * *
REALTIME_WEATHER_ZONE_LEVEL=region


# ============================================================
# Modèles de risque
# ============================================================

# Drought risk model V1
DROUGHT_CLIMATE_DAYS=30
DROUGHT_PRECIP_LOW_MM=30
DROUGHT_PRECIP_HIGH_MM=150
DROUGHT_TEMP_LOW_C=24
DROUGHT_TEMP_HIGH_C=32

# Cyclone risk model / IBTrACS
IBTRACS_SI_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/ibtracs.SI.list.v04r01.csv
CYCLONE_START_YEAR=1980
CYCLONE_DECAY_KM=180
CYCLONE_GAUSSIAN_KM=120
CYCLONE_MIN_LON=35
CYCLONE_MAX_LON=65
CYCLONE_MIN_LAT=-35
CYCLONE_MAX_LAT=0


# ============================================================
# Planificateur ETL Docker (etl/scheduler/cron_jobs.py)
# ============================================================

BACKEND_API_URL=http://localhost:3001/api
PYTHON_BIN=
CYCLONE_SYNC_INTERVAL_HOURS=2
CLIMATE_SYNC_INTERVAL_HOURS=12
RISK_PIPELINE_INTERVAL_HOURS=24
DWH_REFRESH_INTERVAL_HOURS=24
ENABLE_CYCLONE_SYNC=true
ENABLE_CLIMATE_SYNC=true
ENABLE_RISK_PIPELINE_CRON=true
ENABLE_DWH_REFRESH=true
RUN_ON_STARTUP=true
