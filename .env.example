# ============================================================
# RISKCLIM-MG / Madagascar Geo Decision System
# Exemple de configuration environnement
# Ne jamais mettre de vrais secrets dans ce fichier.
# Copier ce fichier vers .env puis adapter les valeurs.
# ============================================================


# ============================================================
# Global
# ============================================================

NODE_ENV=development
APP_NAME=madagascar-geo-decision-system


# ============================================================
# PostgreSQL / PostGIS
# ============================================================

POSTGRES_HOST=postgres-postgis
POSTGRES_PORT=5432
POSTGRES_DB=geodecisionnel
POSTGRES_USER=geodecisionnel
POSTGRES_PASSWORD=geodecisionnel

# Pour les services Docker
DATABASE_URL=postgresql://geodecisionnel:geodecisionnel@postgres-postgis:5432/geodecisionnel

# Pour exécution locale du backend hors Docker, utiliser plutôt :
# DATABASE_URL=postgresql://geodecisionnel:geodecisionnel@localhost:5433/geodecisionnel


# ============================================================
# Backend NestJS
# ============================================================

BACKEND_PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
JWT_SECRET=change-me-in-production
AHP_ENGINE_URL=http://localhost:8000


# ============================================================
# Frontend React / Vite
# ============================================================

FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001
VITE_ADMIN_CONTACT_EMAIL=admin@riskclim.mg
VITE_ADMIN_CONTACT_PHONE=+261 XX XX XXX XX


# ============================================================
# SMTP Gmail / Emails transactionnels
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="RISKCLIM-MG <your-email@gmail.com>"

# Email administrateur recevant les demandes de compte
ADMIN_CONTACT_EMAIL=admin@riskclim.mg


# ============================================================
# OpenTopography / Copernicus DEM GLO-30
# ============================================================

OPENTOPOGRAPHY_API_KEY=d3cd8a156dd8d97c35c4fc0e41d0b94d
OPENTOPOGRAPHY_DEM_TYPE=COP30
DEM_TILE_SIZE_DEGREES=1.0


# ============================================================
# Sources météo / climat
# ============================================================

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPENWEATHER_API_KEY=replace_me
COPERNICUS_API_KEY=replace_me
NASA_EARTHDATA_TOKEN=replace_me


# ============================================================
# MinIO / Object Storage (Stockage objet compatible S3)
# ============================================================

# Identifiants du serveur MinIO (utilisés par le conteneur Docker minio)
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me

# Configuration client S3 pour le backend NestJS
# URL de connexion interne au serveur MinIO :
# - Hors Docker (backend exécuté en local sur la machine hôte) : http://localhost:9000
# - Dans Docker Compose (backend exécuté en conteneur) : http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Authentification S3 : S3_ACCESS_KEY doit être identique à MINIO_ROOT_USER
# et S3_SECRET_KEY identique à MINIO_ROOT_PASSWORD
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me

# Noms des buckets applicatifs (auto-créés au démarrage du backend)
S3_BUCKET_AVATARS=geodecisionnel-avatars
S3_BUCKET_REPORTS=geodecisionnel-reports

# Mode d'adressage et sécurité
# S3_FORCE_PATH_STYLE=true est indispensable pour MinIO (http://endpoint/bucket/key)
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

# URL publique S3 pour l'accès aux assets publics (ex: avatars) depuis le navigateur
# En dev local : http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000


# ============================================================
# Superset / BI
# ============================================================

SUPERSET_SECRET_KEY=change-me

# CHIRPS rainfall
# Mois utilisés pour le cumul pluviométrique saisonnier
CHIRPS_MONTHS=2023-12,2024-01,2024-02,2024-03,2024-04

# WorldPop population
WORLDPOP_YEAR=2020
WORLDPOP_COUNTRY=MDG

# OpenWeather API
OPENWEATHER_API_KEY=replace_me
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Pipeline automatique de risque
RISK_PIPELINE_AUTO_ENABLED=false
# Toutes les 6 heures : seconde minute heure jour mois jourSemaine
RISK_PIPELINE_CRON=0 0 */6 * * *
