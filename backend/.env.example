BACKEND_PORT=4000
DATABASE_URL=postgresql://geodecisionnel:geodecisionnel@localhost:5432/geodecisionnel
JWT_SECRET=change-me
AHP_ENGINE_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:3000

# SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="RISKCLIM-MG <your-email@gmail.com>"

# NASA POWER
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_PARAMETERS=T2M,RH2M,WS2M,PRECTOTCORR
NASA_POWER_DAYS=30
# Optional fixed period:
# NASA_POWER_START=20260701
# NASA_POWER_END=20260730

NASA_POWER_AUTO_ENABLED=false

NASA_POWER_CRON=0 30 2 * * *

# Drought risk model V1
DROUGHT_CLIMATE_DAYS=30
DROUGHT_PRECIP_LOW_MM=30
DROUGHT_PRECIP_HIGH_MM=150
DROUGHT_TEMP_LOW_C=24
DROUGHT_TEMP_HIGH_C=32

# Cyclone risk model / IBTrACS
IBTRACS_SI_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/ibtracs.SI.list.v04r01.csv
CYCLONE_START_YEAR=1980
CYCLONE_DECAY_KM=180
CYCLONE_GAUSSIAN_KM=120
CYCLONE_MIN_LON=35
CYCLONE_MAX_LON=65
CYCLONE_MIN_LAT=-35
CYCLONE_MAX_LAT=0

# Realtime weather ingestion
OPENWEATHER_API_KEY=replace_me
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
REALTIME_WEATHER_ENABLED=false
REALTIME_WEATHER_CRON=0 */30 * * * *
REALTIME_WEATHER_ZONE_LEVEL=region
