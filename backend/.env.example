# ============================================================
# Backend NestJS — exemple de configuration
# Copier vers backend/.env pour un lancement local hors Docker.
#
# Sécurité : les secrets critiques sont volontairement vides.
# Générer un secret long :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Générer une clé ETL :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# Backend
BACKEND_PORT=3001
NODE_ENV=development

# Database
# Local development often uses port 5433 if 5432 is already used locally.
# Exemple : postgresql://geodecisionnel:<POSTGRES_PASSWORD>@localhost:5433/geodecisionnel
DATABASE_URL=
POSTGRES_PASSWORD=

# JWT
JWT_SECRET=

# Clé API machine-to-machine dédiée à l'ETL.
ETL_API_KEY=

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin contact
ADMIN_CONTACT_EMAIL=admin@example.com

# ============================================================
# MinIO / Object Storage compatible S3
# ============================================================

# Identifiants du serveur MinIO si utilisé localement.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Configuration client S3 pour le backend NestJS.
# Hors Docker : http://localhost:9000
# Docker Compose : http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Pour MinIO local, S3_ACCESS_KEY/S3_SECRET_KEY peuvent correspondre
# à MINIO_ROOT_USER/MINIO_ROOT_PASSWORD. En production, préférer si
# possible des identifiants applicatifs dédiés au lieu du compte root.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Noms des buckets applicatifs, auto-créés au démarrage du backend.
S3_BUCKET_AVATARS=geodecisionnel-avatars
S3_BUCKET_REPORTS=geodecisionnel-reports

# Mode d'adressage et sécurité.
# S3_FORCE_PATH_STYLE=true est indispensable pour MinIO.
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

# URL publique S3 pour l'accès navigateur aux assets publics.
S3_PUBLIC_URL=http://localhost:9000

# SMTP / Emails transactionnels
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RISKCLIM-MG <no-reply@example.invalid>"

# OpenWeather
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_DAILY_QUOTA=950

# Realtime weather ingestion
REALTIME_WEATHER_ENABLED=false
REALTIME_WEATHER_CRON=0 */30 * * * *
REALTIME_WEATHER_ZONE_LEVEL=region

# OpenTopography / Copernicus DEM
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DEM_TYPE=COP30
DEM_TILE_SIZE_DEGREES=1.0

# CHIRPS
CHIRPS_MONTHS=2023-12,2024-01,2024-02,2024-03,2024-04

# WorldPop
WORLDPOP_YEAR=2020
WORLDPOP_COUNTRY=MDG

# NASA POWER
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_PARAMETERS=T2M,RH2M,WS2M,PRECTOTCORR
NASA_POWER_DAYS=30
NASA_POWER_AUTO_ENABLED=false
NASA_POWER_CRON=0 30 2 * * *
# Optional fixed period for manual backfill only:
# NASA_POWER_START=20260701
# NASA_POWER_END=20260730

# Drought risk model V1
DROUGHT_CLIMATE_DAYS=30
DROUGHT_PRECIP_LOW_MM=30
DROUGHT_PRECIP_HIGH_MM=150
DROUGHT_TEMP_LOW_C=24
DROUGHT_TEMP_HIGH_C=32

# Cyclone risk model / IBTrACS
IBTRACS_SI_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/ibtracs.SI.list.v04r01.csv
CYCLONE_START_YEAR=1980
CYCLONE_DECAY_KM=180
CYCLONE_GAUSSIAN_KM=120
CYCLONE_MIN_LON=35
CYCLONE_MAX_LON=65
CYCLONE_MIN_LAT=-35
CYCLONE_MAX_LAT=0

# Risk pipeline orchestration
PYTHON_BIN=
BACKEND_API_URL=http://localhost:3001/api

# Raster version history
# When enabled, register_raster_metadata.py copies selected risk rasters
# into etl/data/raster/versions/<TYPE>/ before registering metadata.
RASTER_VERSION_HISTORY_ENABLED=true
RASTER_VERSION_HISTORY_DIR=etl/data/raster/versions
RASTER_VERSION_HISTORY_TYPES=RISK_INDEX,FLOOD_RISK_INDEX,DROUGHT_RISK_INDEX,LANDSLIDE_RISK_INDEX,CYCLONE_RISK_INDEX
RASTER_VERSION_DEDUP_BY_HASH=true

RISK_PIPELINE_AUTO_ENABLED=false
RISK_PIPELINE_CRON=0 0 */6 * * *
ETL_PIPELINE_GENERATE_ALERTS=false

# Validated alerts
VALIDATED_ALERTS_AFTER_PIPELINE=true
VALIDATED_ALERT_ZONE_TYPE=region
VALIDATED_ALERT_RISK_MEAN_THRESHOLD=60
VALIDATED_ALERT_RISK_MAX_THRESHOLD=70
VALIDATED_ALERT_ZONE_LIMIT=10

# Legacy / weather-risk alerts
AUTO_ALERTS_ENABLED=false
AUTO_ALERT_RISK_THRESHOLD=60
AUTO_ALERT_RAINFALL_THRESHOLD=1
AUTO_ALERT_WIND_THRESHOLD=40
AUTO_ALERT_ZONE_LIMIT=10
